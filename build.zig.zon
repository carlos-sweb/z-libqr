.{
    // Package name as generated by `zig init`. The Zig module exposed to
    // consumers is named `zqr` (see build.zig, `b.addModule("zqr", ...)`).
    .name = .z_libqr,
    .version = "1.2.0",
    .fingerprint = 0xf13c8f15aab4e23f, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    // Zero dependencies by design.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "LICENSE",
        "README.md",
    },
}
